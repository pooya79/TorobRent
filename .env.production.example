POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://app:replace-with-a-long-random-password@postgres:5432/app
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO
SENTRY_DSN=
VITE_NESHAN_MAP_KEY=replace-with-a-domain-restricted-map-key
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
APP_PORT=80

# Optional: explicit Operator Source Profile repair only.
SOURCE_PROFILE_REPAIR_API_KEY=
SOURCE_PROFILE_REPAIR_MODEL=
