# Local-only deterministic demo configuration. Do not reuse these credentials elsewhere.
DEMO_APP_PORT=5173
DEMO_MAILPIT_PORT=8025
POSTGRES_DB=torobrent_demo
POSTGRES_USER=torobrent_demo
POSTGRES_PASSWORD=torobrent_demo
DJANGO_SECRET_KEY=torobrent-demo-local-only-secret-key
DATABASE_URL=postgresql://torobrent_demo:torobrent_demo@postgres:5432/torobrent_demo
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
