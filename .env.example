DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
POSTGRES_PORT=5432
REDIS_PORT=6379
DB_CONN_MAX_AGE=0
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Optional npm-compatible registry used by Corepack and pnpm in frontend containers.
NPM_REGISTRY=https://registry.npmjs.org

# Frontend map adapter: openstreetmap (default), neshan, or fake (tests only).
VITE_MAP_ADAPTER=openstreetmap

# Required only when VITE_MAP_ADAPTER=neshan. Use a domain-restricted Neshan key.
VITE_NESHAN_MAP_KEY=

# Optional XYZ tile URL for openstreetmap. Empty uses the public OpenStreetMap tile service;
# configure a production-capable OpenStreetMap-compatible tile service for production traffic.
VITE_OPENSTREETMAP_TILE_URL=
MAILPIT_PORT=8025
VITE_MAILPIT_URL=http://localhost:8025

# Optional managed Contact-page details. Empty values hide their blocks.
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_MAP_URL=

# Production email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com

# Production SMS webhook. It receives {"recipient": "09...", "code": "......"} as JSON.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_TIMEOUT_SECONDS=5

# Optional observability
SENTRY_DSN=

# Optional: explicit Operator Source Profile repair only.
SOURCE_PROFILE_REPAIR_API_KEY=
SOURCE_PROFILE_REPAIR_MODEL=
